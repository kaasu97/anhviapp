# Chuỗi kết nối Postgres. Lấy từ Neon (neon.tech), Supabase, Railway,
# hoặc bất kỳ Postgres nào khác. Ví dụ Neon thường có dạng:
# postgresql://user:password@ep-xxxx.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/anhviapp"

# Tạo một chuỗi ngẫu nhiên riêng, ví dụ:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="replace-with-a-random-secret"
